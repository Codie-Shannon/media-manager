<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:MediaControls="clr-namespace:MediaControlsLibrary"
                    xmlns:Models="clr-namespace:MediaControlsLibrary.Models"
                    xmlns:Commands="clr-namespace:MediaControlsLibrary.Commands"
                    xmlns:Converters="clr-namespace:MediaControlsLibrary.Converters">
    <!-- Styles -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="\MediaControlsLibrary;component\Resources\Styles.xaml"/>
    </ResourceDictionary.MergedDictionaries>





    <!-- Converters -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <Converters:DialogClearVisibilityConverter x:Key="VisibilityConverter"/>
    <Converters:DialogClearPaddingConverter x:Key="PaddingConverter"/>





    <!-- Control Template -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <ControlTemplate x:Key="OpenDialogTemplate" TargetType="{x:Type MediaControls:optOpenDialog}">
        <Grid x:Name="PART_Content" Style="{StaticResource OptionsPanel.Item}">
            <Grid.RowDefinitions>
                <RowDefinition Height="32.5"/>
                <RowDefinition Height="32.5"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="0.25*"/>
            </Grid.ColumnDefinitions>

            <!-- Header -->
            <!-- ==================================== -->
            <!-- ==================================== -->
            <!-- ==================================== -->
            <TextBlock Text="{TemplateBinding Header}" Style="{StaticResource OptionsPanel.Item.Header}"/>



            
            
            <!-- Text and Clear Button -->
            <!-- ==================================== -->
            <!-- ==================================== -->
            <!-- ==================================== -->
            <!-- ==================================== -->
            <Grid Style="{StaticResource OptionsPanel.Dialog.Content.Group}">
                <!-- Text -->
                <!-- ==================================== -->
                <!-- ==================================== -->
                <!-- ==================================== -->
                <TextBox x:Name="PART_Text" Text="{TemplateBinding Content}" Style="{StaticResource OptionsPanel.Dialog.Content}" Padding="{TemplateBinding IsClear, Converter={StaticResource PaddingConverter}}"/>




                <!-- Clear Button -->
                <!-- ==================================== -->
                <!-- ==================================== -->
                <!-- ==================================== -->
                <Button x:Name="PART_Clear" Content="&#xE894;" Style="{StaticResource OptionsPanel.Dialog.Content.Clear.Button}" Visibility="{TemplateBinding IsClear, Converter={StaticResource VisibilityConverter}}"/>
            </Grid>





            <!-- Placeholder Text -->
            <!-- ==================================== -->
            <!-- ==================================== -->
            <!-- ==================================== -->
            <!-- ==================================== -->
            <TextBlock Text="{TemplateBinding Placeholder}" Grid.Row="1" FontSize="13" Padding="8 0 6 0" Foreground="{StaticResource OptionsPanel.Item.Placeholder.Text.Static.Foreground}" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=PART_Text}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>



            
            
            <!-- Button -->
            <!-- ==================================== -->
            <!-- ==================================== -->
            <!-- ==================================== -->
            <!-- ==================================== -->
            <Button x:Name="PART_Button" Content="{TemplateBinding ButtonContent}" Style="{StaticResource OptionsPanel.Dialog.Button}"/>



            
            
            <!-- Items -->
            <!-- ==================================== -->
            <!-- ==================================== -->
            <!-- ==================================== -->
            <!-- ==================================== -->
            <ItemsControl x:Name="PART_Items" Grid.Row="2" Grid.ColumnSpan="2" Background="White" Margin="1 0 0 0">
                <!-- Items Panel -->
                <!-- ==================================== -->
                <!-- ==================================== -->
                <!-- ==================================== -->
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- Virtualizing Wrap Panel -->
                        <!-- ==================================== -->
                        <!-- ==================================== -->
                        <VirtualizingStackPanel x:Name="spItems" IsVirtualizing="True" VirtualizationMode="Recycling" Orientation="Horizontal" Height="130" Margin="5"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                


                <!-- Item Template -->
                <!-- ==================================== -->
                <!-- ==================================== -->
                <!-- ==================================== -->
                <ItemsControl.ItemTemplate>
                    <!-- Music DataTemplate -->
                    <!-- ============================== -->
                    <DataTemplate DataType="{x:Type Models:OpenDialogItem}">
                        <!-- Selection Item -->
                        <!-- ==================================== -->
                        <!-- ==================================== -->
                        <Button Uid="{Binding Id}" Tag="{Binding FilePath}" Style="{StaticResource OptionsPanel.Dialog.Multiselect.Item.Button}">
                            <Button.Background> <ImageBrush ImageSource="{Binding Cover}"/> </Button.Background>
                            <!-- TextBlock -->
                            <!-- ==================================== -->
                            <TextBlock Text="{Binding Name}" Style="{StaticResource OptionsPanel.Dialog.Multiselect.Item.TextBlock}"/>


                            <!-- Item's Context Menu -->
                            <!-- ==================================== -->
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource OptionsPanel.Dialog.Multiselect.Item.ContextMenu}">
                                    <MenuItem x:Name="miRemove" Header="{Binding RemoveHeader}" Command="{x:Static Commands:OpenDialogCommands.RemoveClick}" CommandTarget="{Binding Path=PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource OptionsPanel.Dialog.Multiselect.Item.MenuItem}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>




                <!-- Items Control Template -->
                <!-- ==================================== -->
                <!-- ==================================== -->
                <!-- ==================================== -->
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
                            <ScrollViewer CanContentScroll="True" Padding="{TemplateBinding Padding}" Focusable="False" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Visible">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </ItemsControl.Template>
            </ItemsControl>
        </Grid>
    </ControlTemplate>

    


    
    <!-- Default Element Style -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <Style TargetType="{x:Type MediaControls:optOpenDialog}">
        <Setter Property="Template" Value="{StaticResource OpenDialogTemplate}"/>
    </Style>
</ResourceDictionary>