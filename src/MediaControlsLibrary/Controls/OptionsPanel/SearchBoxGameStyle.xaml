<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:MediaControls="clr-namespace:MediaControlsLibrary">
    <!-- Styles -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="\MediaControlsLibrary;component\Resources\Styles.xaml"/>
    </ResourceDictionary.MergedDictionaries>



    <!-- Control Template -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <ControlTemplate x:Key="SearchBoxGameTemplate" TargetType="{x:Type MediaControls:optSearchBoxGame}">
        <StackPanel
            AutomationProperties.Name="{TemplateBinding Content}"
            Style="{StaticResource OptionsPanel.Search.Content.StackPanel}">
            <Border Style="{StaticResource OptionsPanel.Search.Content.Image.Border}">
                <Border.Background>
                    <!-- Image -->
                    <!-- ==================================== -->
                    <ImageBrush x:Name="PART_Image" Stretch="Uniform"/>
                </Border.Background>
            </Border>

            <StackPanel Orientation="Vertical">
                <!-- Title -->
                <!-- ==================================== -->
                <!-- ==================================== -->
                <TextBlock Text="{TemplateBinding Content}" Style="{StaticResource OptionsPanel.Search.Content.TextBlock}"/>


                <!-- Platforms -->
                <!-- ==================================== -->
                <!-- ==================================== -->
                <TextBlock x:Name="PART_Platforms" Style="{StaticResource OptionsPanel.Search.Content.TextBlock}"/>


                <!-- Type -->
                <!-- ==================================== -->
                <!-- ==================================== -->
                <TextBlock Text="{TemplateBinding Type}" Style="{StaticResource OptionsPanel.Search.Content.TextBlock}"/>
            </StackPanel>
        </StackPanel>
    </ControlTemplate>



    <!-- Default Element Style -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <Style TargetType="{x:Type MediaControls:optSearchBoxGame}">
        <Setter Property="Template" Value="{StaticResource SearchBoxGameTemplate}"/>
    </Style>
</ResourceDictionary>
