<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:MediaControls="clr-namespace:MediaControlsLibrary">
    <!-- Styles -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="\MediaControlsLibrary;component\Resources\Styles.xaml"/>
    </ResourceDictionary.MergedDictionaries>



    <!-- Control Template -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <ControlTemplate x:Key="DialogTemplate" TargetType="{x:Type MediaControls:optFolderBrowserDialog}">
        <Grid x:Name="PART_Content" Style="{StaticResource OptionsPanel.Item}">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="0.25*"/>
            </Grid.ColumnDefinitions>

            <!-- Header -->
            <!-- ==================================== -->
            <!-- ==================================== -->
            <TextBlock Text="{TemplateBinding Header}" Style="{StaticResource OptionsPanel.Item.Header}"/>


            <!-- Text -->
            <!-- ==================================== -->
            <!-- ==================================== -->
            <TextBox x:Name="PART_Text" Text="{TemplateBinding Content}" Style="{StaticResource OptionsPanel.Dialog.Content}"/>


            <!-- Placeholder Text -->
            <!-- ==================================== -->
            <!-- ==================================== -->
            <TextBlock Text="{TemplateBinding Placeholder}" Grid.Row="1" FontSize="13" Padding="8 0 6 0" Foreground="{StaticResource OptionsPanel.Item.Placeholder.Text.Static.Foreground}" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=PART_Text}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>


            <!-- Button -->
            <!-- ==================================== -->
            <!-- ==================================== -->
            <Button x:Name="PART_Button" Content="{TemplateBinding ButtonContent}" Style="{StaticResource OptionsPanel.Dialog.Button}"/>
        </Grid>
    </ControlTemplate>



    <!-- Default Element Style -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <Style TargetType="{x:Type MediaControls:optFolderBrowserDialog}">
        <Setter Property="Template" Value="{StaticResource DialogTemplate}"/>
    </Style>
</ResourceDictionary>