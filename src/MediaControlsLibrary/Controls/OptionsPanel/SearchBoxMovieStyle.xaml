<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:MediaControls="clr-namespace:MediaControlsLibrary">
    <!-- Styles -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="\MediaControlsLibrary;component\Resources\Styles.xaml"/>
    </ResourceDictionary.MergedDictionaries>



    <!-- Control Template -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <ControlTemplate x:Key="SearchBoxMovieTemplate" TargetType="{x:Type MediaControls:optSearchBoxMovie}">
        <StackPanel Style="{StaticResource OptionsPanel.Search.Content.StackPanel}">
            <Border Style="{StaticResource OptionsPanel.Search.Content.Image.Border}">
                <Border.Background>
                    <!-- Image -->
                    <!-- ==================================== -->
                    <ImageBrush x:Name="PART_Image" Stretch="Uniform"/>
                </Border.Background>
            </Border>
            <!-- Content -->
            <!-- ==================================== -->
            <!-- ==================================== -->
            <TextBlock Text="{TemplateBinding Content}" Style="{StaticResource OptionsPanel.Search.Content.TextBlock}"/>
        </StackPanel>
    </ControlTemplate>



    <!-- Default Element Style -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <Style TargetType="{x:Type MediaControls:optSearchBoxMovie}">
        <Setter Property="Template" Value="{StaticResource SearchBoxMovieTemplate}"/>
    </Style>
</ResourceDictionary>