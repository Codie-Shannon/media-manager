<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:MediaControls="clr-namespace:MediaControlsLibrary"
                    xmlns:Converters="clr-namespace:MediaControlsLibrary.Converters.Elements">
    <!-- Styles -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="\MediaControlsLibrary;component\Resources\Styles.xaml"/>
    </ResourceDictionary.MergedDictionaries>



    <!-- Converters -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <Converters:TVShowFolderToggle x:Key="TVShowFolderToggle"/>



    <!-- Control Template -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <ControlTemplate x:Key="CoverFolderTemplate" TargetType="{x:Type MediaControls:CoverFolder}">
        <Button x:Name="PART_Content" AutomationProperties.Name="{TemplateBinding Content}" Style="{StaticResource Cover.Folder.Button}" Command="{TemplateBinding Command}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="ElementStates">
                    <VisualState x:Name="Unselected"/>
                    <VisualState x:Name="Selected">
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetName="PART_Content" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#FF43B5FF" Duration="0"/>
                            <ThicknessAnimation Storyboard.TargetName="PART_Content" Storyboard.TargetProperty="BorderThickness" To="2" Duration="0" FillBehavior="HoldEnd"/>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <!-- Main Grid -->
            <!-- ==================================== -->
            <!-- ==================================== -->
            <Grid>
                <!-- Cover Image -->
                <!-- ==================================== -->
                <Image x:Name="PART_Image" Stretch="UniformToFill"/>

                
                <!-- Content -->
                <!-- ==================================== -->
                <TextBlock Text="{TemplateBinding Content}" Style="{StaticResource Folder.Button.Overlay.TextBlock}"/>
            </Grid>
        </Button>
    </ControlTemplate>


    
    <!-- Default Element Style -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <Style TargetType="{x:Type MediaControls:CoverFolder}">
        <Setter Property="Template" Value="{StaticResource CoverFolderTemplate}"/>
    </Style>
</ResourceDictionary>
