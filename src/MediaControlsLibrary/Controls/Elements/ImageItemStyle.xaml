<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:MediaControls="clr-namespace:MediaControlsLibrary" xmlns:theme="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero2">
    <!-- Styles -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="\MediaControlsLibrary;component\Resources\Styles.xaml"/>
    </ResourceDictionary.MergedDictionaries>



    <!-- Control Template -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <ControlTemplate x:Key="ImageItemTemplate" TargetType="{x:Type MediaControls:ImageItem}">
        <Button x:Name="PART_Content" AutomationProperties.Name="{TemplateBinding Content}" Style="{StaticResource Image.Item.Button}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="ElementStates">
                    <VisualState x:Name="Unselected"/>
                    <VisualState x:Name="Selected">
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetName="PART_Content" Storyboard.TargetProperty="(Button.BorderBrush).(SolidColorBrush.Color)" To="#FF43B5FF" Duration="0"/>
                            <ThicknessAnimation Storyboard.TargetName="PART_Content" Storyboard.TargetProperty="BorderThickness" To="2" Duration="0" FillBehavior="HoldEnd"/>
                            <DoubleAnimation Storyboard.TargetName="PART_Overlay" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0"/>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>


            <!-- Main Grid -->
            <!-- ==================================== -->
            <!-- ==================================== -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>
                <!-- Cover Image -->
                <!-- ==================================== -->
                <Image x:Name="PART_Image" Stretch="UniformToFill"/>

                
                <!-- Overlay -->
                <!-- ==================================== -->
                <Grid x:Name="PART_Overlay" Grid.Row="1" Style="{StaticResource Image.Item.Overlay}">
                    <!-- Content -->
                    <TextBlock Text="{TemplateBinding Content}" Style="{StaticResource Image.Item.Content.TextBlock}"/>
                </Grid>
            </Grid>
        </Button>
    </ControlTemplate>


    
    <!-- Default Element Style -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <Style TargetType="{x:Type MediaControls:ImageItem}">
        <Setter Property="Template" Value="{StaticResource ImageItemTemplate}"/>
    </Style>
</ResourceDictionary>
