<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:MediaControls="clr-namespace:MediaControlsLibrary">
    <!-- Styles -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="\MediaControlsLibrary;component\Resources\Styles.xaml"/>
    </ResourceDictionary.MergedDictionaries>


    <!-- Control Template -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <ControlTemplate x:Key="NavigationViewItemHeaderTemplate"  TargetType="{x:Type MediaControls:NavigationViewItemHeader}">
        <Label Content="{TemplateBinding Content}" Style="{StaticResource NavigationViewItemHeader}" Margin="{TemplateBinding Margin}"/>
    </ControlTemplate>


    <!-- Default Element Style -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <Style TargetType="{x:Type MediaControls:NavigationViewItemHeader}">
        <Setter Property="Template" Value="{StaticResource NavigationViewItemHeaderTemplate}"/>
        <Setter Property="Margin" Value="10 0 5 0"/>
    </Style>
</ResourceDictionary>