<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:MediaControls="clr-namespace:MediaControlsLibrary">
    <!-- Styles -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="\MediaControlsLibrary;component\Resources\Styles.xaml"/>
    </ResourceDictionary.MergedDictionaries>


    
    <!-- Control Template -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <ControlTemplate x:Key="NavigationViewItemTemplate"  TargetType="{x:Type MediaControls:NavigationViewItem}">
        <Button x:Name="PART_Content" AutomationProperties.Name="{TemplateBinding Label}" Style="{StaticResource NavigationViewItem.Button}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="MenuItemStates">
                    <VisualState x:Name="MouseOver">
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)" To="{StaticResource NavigationViewItem.MouseOver.Background}" Duration="0:0:0.12"/>
                            <ColorAnimation Storyboard.TargetProperty="(Button.BorderBrush).(SolidColorBrush.Color)" To="{StaticResource NavigationViewItem.Transparent}" Duration="0"/>
                            <ColorAnimation Storyboard.TargetProperty="(Button.Foreground).(SolidColorBrush.Color)" To="{StaticResource NavigationViewItem.MouseOver.Foreground}" Duration="0:0:0.3"/>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Selected">
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)" To="{StaticResource NavigationViewItem.Selected.Background}" Duration="0:0:0.12"/>
                            <ColorAnimation Storyboard.TargetProperty="(Button.BorderBrush).(SolidColorBrush.Color)" To="{StaticResource NavigationViewItem.Selected.Border}" Duration="0:0:0.3"/>
                            <ColorAnimation Storyboard.TargetProperty="(Button.Foreground).(SolidColorBrush.Color)" To="{StaticResource NavigationViewItem.Selected.Foreground}" Duration="0:0:0.3"/>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Unselected">
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)" To="{StaticResource NavigationViewItem.Transparent}" Duration="0"/>
                            <ColorAnimation Storyboard.TargetProperty="(Button.BorderBrush).(SolidColorBrush.Color)" To="{StaticResource NavigationViewItem.Transparent}" Duration="0"/>
                            <ColorAnimation Storyboard.TargetProperty="(Button.Foreground).(SolidColorBrush.Color)" To="{StaticResource NavigationViewItem.Unselected.Foreground}" Duration="0"/>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <DockPanel>
                <!-- Icon -->
                <!-- ==================================== -->
                <!-- ==================================== -->
                <TextBlock Text="{TemplateBinding Icon}" Style="{StaticResource NavigationViewItem.Icon}"/>
                
                
                <!-- Label -->
                <!-- ==================================== -->
                <!-- ==================================== -->
                <TextBlock Text="{TemplateBinding Label}" Style="{StaticResource NavigationViewItem.Label}"/>
            </DockPanel>
        </Button>
    </ControlTemplate>


    
    <!-- Default Element Style -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <Style TargetType="{x:Type MediaControls:NavigationViewItem}">
        <Setter Property="Template" Value="{StaticResource NavigationViewItemTemplate}"/>
    </Style>
</ResourceDictionary>
