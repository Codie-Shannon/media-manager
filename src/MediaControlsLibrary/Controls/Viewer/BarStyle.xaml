<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:MediaControls="clr-namespace:MediaControlsLibrary">
    <!-- Styles -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="\MediaControlsLibrary;component\Resources\Styles.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    

    <!-- Control Template -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <ControlTemplate x:Key="BarTemplate" TargetType="{x:Type MediaControls:viewBar}">
        <Grid Background="{StaticResource Viewer.Bar.Background}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            <!-- Items -->
            <!-- ==================================== -->
            <!-- ==================================== -->
            <StackPanel IsItemsHost="True" Style="{StaticResource Viewer.Bar.Items}"/>

            
            <!-- Fullscreen Button -->
            <!-- ==================================== -->
            <!-- ==================================== -->
            <MediaControls:viewIconButton x:Name="PART_Button" PrimaryIcon="&#xe740;" SecondaryIcon="&#xe73f;" Grid.Column="1"/>
        </Grid>
    </ControlTemplate>


    
    <!-- Default Element Style -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <Style TargetType="{x:Type MediaControls:viewBar}">
        <Setter Property="Template" Value="{StaticResource BarTemplate}"/>
        <Setter Property="Panel.ZIndex" Value="1"/>
    </Style>
</ResourceDictionary>