<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:MediaControls="clr-namespace:MediaControlsLibrary">
    <!-- Styles -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="\MediaControlsLibrary;component\Resources\Styles.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    
    <!-- Control Template -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <ControlTemplate x:Key="DetailsTemplate" TargetType="{x:Type MediaControls:ipDetails}">
        <ScrollViewer Style="{DynamicResource InformationPane.Details}">
            <ItemsControl Margin="10 0 0 0">
                <ItemsPresenter/>
            </ItemsControl>
        </ScrollViewer>
    </ControlTemplate>


    <!-- Default Element Style -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <Style TargetType="{x:Type MediaControls:ipDetails}">
        <Setter Property="Template" Value="{StaticResource DetailsTemplate}"/>
    </Style>
</ResourceDictionary>