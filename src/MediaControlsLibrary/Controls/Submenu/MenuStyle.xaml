<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:MediaControls="clr-namespace:MediaControlsLibrary">
    <!-- Styles -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="\MediaControlsLibrary;component\Resources\Styles.xaml"/>
    </ResourceDictionary.MergedDictionaries>


    <!-- Control Template -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <ControlTemplate x:Key="SubmenuTemplate" TargetType="{x:Type MediaControls:subMenu}">
        <Border Style="{StaticResource Submenu.Border}">
            <ScrollViewer
                HorizontalScrollBarVisibility="Auto"
                PanningMode="HorizontalOnly"
                VerticalScrollBarVisibility="Disabled">
                <StackPanel IsItemsHost="True" Style="{StaticResource Submenu.StackPanel}"/>
            </ScrollViewer>
        </Border>
    </ControlTemplate>


    <!-- Default Element Style -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <Style TargetType="{x:Type MediaControls:subMenu}">
        <Setter Property="Template" Value="{StaticResource SubmenuTemplate}"/>
    </Style>
</ResourceDictionary>
