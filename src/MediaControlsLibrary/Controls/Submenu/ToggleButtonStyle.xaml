<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:MediaControls="clr-namespace:MediaControlsLibrary">
    <!-- Styles -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="\MediaControlsLibrary;component\Resources\Styles.xaml"/>
    </ResourceDictionary.MergedDictionaries>


    
    <!-- Control Template -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <ControlTemplate x:Key="ToggleButtonTemplate" TargetType="{x:Type MediaControls:subToggleButton}">
        <ToggleButton x:Name="PART_Content" Style="{StaticResource Submenu.Toggle.Button}" Width="{TemplateBinding Width}">
            <Grid Style="{StaticResource Submenu.Button.Grid}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2.3*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <!-- Icon -->
                <!-- ==================================== -->
                <!-- ==================================== -->
                <TextBlock Text="{TemplateBinding Icon}" Style="{StaticResource Submenu.Button.Icon}"/>
                
                
                <!-- Content -->
                <!-- ==================================== -->
                <!-- ==================================== -->
                <CheckBox Content="{TemplateBinding Content}" IsChecked="{Binding ElementName=PART_Content,Path=IsChecked}" Style="{StaticResource Submenu.Toggle}"/>
            </Grid>
        </ToggleButton>
    </ControlTemplate>


    
    <!-- Default Element Style -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <Style TargetType="{x:Type MediaControls:subToggleButton}">
        <Setter Property="Template" Value="{StaticResource ToggleButtonTemplate}"/>
        <Setter Property="Width" Value="125"/>
    </Style>
</ResourceDictionary>