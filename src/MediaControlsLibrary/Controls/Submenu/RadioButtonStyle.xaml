<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:MediaControls="clr-namespace:MediaControlsLibrary">
    <!-- Styles -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="\MediaControlsLibrary;component\Resources\Styles.xaml"/>
    </ResourceDictionary.MergedDictionaries>


    <!-- Control Template -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <ControlTemplate x:Key="RadioButtonTemplate" TargetType="{x:Type MediaControls:subRadioButton}">
        <RadioButton Content="{TemplateBinding Content}" IsChecked="{TemplateBinding IsChecked}" Style="{StaticResource Submenu.RadioButton}"/>
    </ControlTemplate>


    <!-- Default Element Style -->
    <!-- ========================================================================== -->
    <!-- ========================================================================== -->
    <Style TargetType="{x:Type MediaControls:subRadioButton}">
        <Setter Property="Template" Value="{StaticResource RadioButtonTemplate}"/>
    </Style>
</ResourceDictionary>