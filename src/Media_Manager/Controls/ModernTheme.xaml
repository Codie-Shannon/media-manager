<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Media_Manager.Controls">

    <SolidColorBrush x:Key="Modern.Window" Color="#FF0B1016"/>
    <SolidColorBrush x:Key="Modern.Sidebar" Color="#FF0E151D"/>
    <SolidColorBrush x:Key="Modern.Header" Color="#FF101821"/>
    <SolidColorBrush x:Key="Modern.Surface" Color="#FF121B25"/>
    <SolidColorBrush x:Key="Modern.SurfaceRaised" Color="#FF18232F"/>
    <SolidColorBrush x:Key="Modern.Border" Color="#FF293746"/>
    <SolidColorBrush x:Key="Modern.BorderStrong" Color="#FF3A4B5D"/>
    <SolidColorBrush x:Key="Modern.Accent" Color="#FF43B5FF"/>
    <SolidColorBrush x:Key="Modern.AccentSoft" Color="#263FAEFF"/>
    <SolidColorBrush x:Key="Modern.TextPrimary" Color="#FFF5F8FB"/>
    <SolidColorBrush x:Key="Modern.TextSecondary" Color="#FFB7C3CF"/>
    <SolidColorBrush x:Key="Modern.TextMuted" Color="#FF7F8D9C"/>
    <SolidColorBrush x:Key="Modern.Success" Color="#FF73D475"/>
    <SolidColorBrush x:Key="Modern.Danger" Color="#FFFF6B76"/>

    <Style x:Key="Modern.WindowHeaderTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource Modern.TextPrimary}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Modern.WindowHeaderSubtitle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource Modern.TextMuted}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0 3 0 0"/>
    </Style>

    <Style x:Key="Modern.BrandIcon" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Background" Value="{StaticResource Modern.AccentSoft}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Modern.Accent}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="Modern.StatusText" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource Modern.TextSecondary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="LineHeight" Value="19"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="Modern.PasswordBox" TargetType="{x:Type PasswordBox}">
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="10 5"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{StaticResource Modern.Window}"/>
        <Setter Property="Foreground" Value="{StaticResource Modern.TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Modern.BorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Grid.Row" Value="1"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Modern.Accent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Background" Value="{StaticResource Modern.SurfaceRaised}"/>
        <Setter Property="Foreground" Value="{StaticResource Modern.TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Modern.BorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="9 6"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style TargetType="{x:Type controls:ModernEmptyState}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ModernEmptyState}">
                    <Border
                        Width="420"
                        Padding="36"
                        Background="{StaticResource Modern.Surface}"
                        BorderBrush="{StaticResource Modern.Border}"
                        BorderThickness="1"
                        CornerRadius="14">
                        <StackPanel HorizontalAlignment="Center">
                            <Border
                                Width="58"
                                Height="58"
                                Margin="0 0 0 18"
                                Background="{StaticResource Modern.AccentSoft}"
                                BorderBrush="{StaticResource Modern.Accent}"
                                BorderThickness="1"
                                CornerRadius="29">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="25"
                                    Foreground="{StaticResource Modern.Accent}"
                                    Text="&#xE8B7;"/>
                            </Border>
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource Modern.TextPrimary}"
                                Text="{TemplateBinding Heading}"/>
                            <TextBlock
                                Width="320"
                                Margin="0 8 0 0"
                                HorizontalAlignment="Center"
                                FontSize="13"
                                Foreground="{StaticResource Modern.TextSecondary}"
                                Text="{TemplateBinding Message}"
                                TextAlignment="Center"
                                TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="Modern.LibraryItemsTemplate" TargetType="{x:Type ItemsControl}">
        <Grid Background="{TemplateBinding Background}">
            <ScrollViewer
                Padding="{TemplateBinding Padding}"
                CanContentScroll="True"
                Focusable="False"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <ItemsPresenter/>
            </ScrollViewer>
            <controls:ModernEmptyState x:Name="EmptyState" Visibility="Collapsed"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="HasItems" Value="False">
                <Setter TargetName="EmptyState" Property="Visibility" Value="Visible"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
