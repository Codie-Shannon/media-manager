<UserControl x:Class="Media_Manager.Views.MusicPlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:MediaControls="clr-namespace:MediaControlsLibrary;assembly=MediaControlsLibrary" xmlns:FFME="http://schemas.microsoft.com/netfx/2009/xaml/presentation"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border
        Padding="14"
        Background="{StaticResource Modern.Surface}"
        BorderBrush="{StaticResource Modern.Border}"
        BorderThickness="1"
        CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock
                    FontSize="10"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource Modern.Accent}"
                    Text="NOW PLAYING"/>
                <TextBlock
                    Margin="0 4 0 0"
                    FontSize="12"
                    Foreground="{StaticResource Modern.TextMuted}"
                    Text="Private, local playback"/>
            </StackPanel>

            <MediaControls:ipTitle
                x:Name="Title"
                Grid.Row="1"
                Margin="0 10 0 0"
                AutomationProperties.Name="Current track"
                Content="Select a track"/>

            <Border
                Grid.Row="3"
                Background="{StaticResource Modern.Window}"
                BorderBrush="{StaticResource Modern.BorderStrong}"
                BorderThickness="1"
                CornerRadius="10">
                <MediaControls:ipCover
                    x:Name="Cover"
                    Margin="1"
                    Source="../Textures/Music_Cover_Default.png"
                    Stretch="UniformToFill"/>
            </Border>

            <UniformGrid Grid.Row="5" HorizontalAlignment="Center" Rows="1" MaxWidth="280">
            <!-- Previous Button -->
            <!-- ============================== -->
            <!-- ============================== -->
            <MediaControls:viewIconButton x:Name="btnPrevious" Icon="&#xf8ac;" ToolTip="Previous track" ButtonBase.Click="btnSkipItem_Click"/>


            <!-- Play / Pause Button -->
            <!-- ============================== -->
            <!-- ============================== -->
            <MediaControls:viewIconButton x:Name="btnPlay" PrimaryIcon="&#xE769;" SecondaryIcon="&#xf5b0;" ToolTip="Play or pause" Background="{StaticResource Modern.AccentSoft}" BorderBrush="{StaticResource Modern.Accent}" ButtonBase.Click="btnPlay_Click"/>


            <!-- Stop Button -->
            <!-- ============================== -->
            <!-- ============================== -->
            <MediaControls:viewIconButton x:Name="btnStop" Icon="&#xe002;" ToolTip="Stop" ButtonBase.Click="btnStop_Click"/>


            <!-- Next Button -->
            <!-- ============================== -->
            <!-- ============================== -->
            <MediaControls:viewIconButton x:Name="btnNext" Icon="&#xf8ad;" ToolTip="Next track" ButtonBase.Click="btnSkipItem_Click"/>


            <!-- Volume Bar -->
            <!-- ============================== -->
            <!-- ============================== -->
            <MediaControls:viewVolumeBar x:Name="VolumeBar" ToolTip="Volume" MuteClick="VolumeBar_MuteClick" ValueUpdated="VolumeBar_ValueUpdated"/>
            </UniformGrid>



        <!-- Media Element -->
        <!-- ============================== -->
        <!-- ============================== -->
        <!-- ============================== -->
            <FFME:MediaElement x:Name="meMusic" Visibility="Hidden" LoadedBehavior="Manual"/>
        </Grid>
    </Border>
</UserControl>
